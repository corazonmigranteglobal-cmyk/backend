# =========================
# APP
# =========================
PORT=3003
NODE_ENV=development

# API KEY (si tu backend valida requests internas)
API_KEY=REPLACE_ME_API_KEY

# =========================
# DATABASE - ACCESS (Neon / Postgres)
# =========================
PGHOST=REPLACE_ME_PGHOST
PGPORT=5432
PGUSER=REPLACE_ME_PGUSER
PGPASSWORD=REPLACE_ME_PGPASSWORD
PGDATABASE=REPLACE_ME_PGDATABASE

SSLMODE=require
DB_SSL=true
PG_CONN_TIMEOUT=20000

# =========================
# REDIS CONFIG
# =========================
REDIS_URL=redis://127.0.0.1:6379
OUTBOX_BATCH_SIZE=20
OUTBOX_INTERVAL_MS=1000

# =========================
# EMAIL SERVER CONFIG
# =========================
MAIL_PROVIDER=sendgrid
MAIL_FROM=no-reply@corazondemigrante.com
MAIL_FROM_NAME=Corazón Migrante
MAIL_REPLY_TO=corazonmigrante.global@gmail.com

# Si usas SendGrid
SENDGRID_API_KEY=REPLACE_ME_SENDGRID_API_KEY

# =========================
# EMAIL TESTER (Gmail OAuth)
# =========================
GMAIL_USER=REPLACE_ME_GMAIL_USER
GOOGLE_CLIENT_ID=REPLACE_ME_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=REPLACE_ME_GOOGLE_CLIENT_SECRET

# Si tu API de envío usa una API KEY aparte
EMAIL_SEND_API_KEY=REPLACE_ME_EMAIL_SEND_API_KEY

# ===========================
# --- Google Cloud / GCS ---
# ===========================
GCP_PROJECT_ID=REPLACE_ME_GCP_PROJECT_ID

# Bucket PRIVADO (usuarios)
GCS_BUCKET_NAME_USER_MEDIA=REPLACE_ME_BUCKET_USER_MEDIA
GCS_PUBLIC_MODE_USER_MEDIA=false
GCS_UPLOAD_PREFIX_USER_MEDIA=users

# Bucket PÚBLICO (vistas públicas)
GCS_BUCKET_NAME_PUBLIC_ASSETS=REPLACE_ME_BUCKET_PUBLIC_ASSETS
GCS_PUBLIC_MODE_PUBLIC_ASSETS=true
GCS_UPLOAD_PREFIX_PUBLIC_ASSETS=admin_portal

# TTL Signed URL (segundos)
GCS_SIGNED_URL_TTL_SECONDS=7200

# Ruta al archivo de credenciales (NO subas el JSON real al repo)
GOOGLE_APPLICATION_CREDENTIALS=./secrets/REPLACE_ME_SERVICE_ACCOUNT.json

# ===========================
# ------ JWT CONFIG ---------
# ===========================
JWT_SECRET=REPLACE_ME_LONG_RANDOM_SECRET
JWT_TTL_SECONDS=28800
