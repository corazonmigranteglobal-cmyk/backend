NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
APP_NAME=Corazon Migrante Backend
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
LOG_LEVEL=info
LOG_FILE_PATH=storage/logs/app.log

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=corazon_migrante
DATABASE_USER=corazon
DATABASE_PASSWORD=corazon
DATABASE_SSL=false
DATABASE_LOGGING=false

# En Coolify se recomienda REDIS_URL del Redis dedicado.
# Ejemplo: redis://default:password@redis-host-interno:6379/0
REDIS_ENABLED=true
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS=false

JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=30

BCRYPT_ROUNDS=10

# Archivos
# CLOUDINARY = fotos publicas con subida directa desde el frontend y registro de URL en backend.
# LOCAL/GCS quedan solo como compatibilidad legacy.
STORAGE_PROVIDER=CLOUDINARY
UPLOAD_DIR=storage/uploads
MAX_UPLOAD_MB=8
PUBLIC_BASE_URL=http://localhost:3000
FILE_SIGNED_URL_EXPIRES_SECONDS=900

# Cloudinary. Requerido si STORAGE_PROVIDER=CLOUDINARY.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=corazon-migrante
CLOUDINARY_UPLOAD_PREFIX_USER_MEDIA=users
CLOUDINARY_UPLOAD_PREFIX_PUBLIC_ASSETS=public

# Google Cloud Storage legacy. Requerido solo si STORAGE_PROVIDER=GCS.
# En producción se recomienda usar Workload Identity / Service Account del runtime.
# En local puedes usar GOOGLE_APPLICATION_CREDENTIALS=/ruta/service-account.json
GCS_BUCKET=
GCP_PROJECT_ID=
GCS_PUBLIC_BASE_URL=
GOOGLE_APPLICATION_CREDENTIALS=

# Email
# DEV_NULL = simula envío. SENDGRID = envío real con SendGrid.
EMAIL_PROVIDER=DEV_NULL
EMAIL_FROM_EMAIL=
EMAIL_FROM_NAME=Corazón Migrante
SENDGRID_API_KEY=

# Backup hacia una base remota de Neon.
# Requiere pg_dump y pg_restore instalados en el runtime/job.
# SOURCE_DATABASE_URL es opcional; si está vacío, se construye desde DATABASE_HOST/USER/PASSWORD/NAME.
SOURCE_DATABASE_URL=
NEON_BACKUP_DATABASE_URL=
BACKUP_CONFIRM_REMOTE_NEON=false
BACKUP_RESTORE_TO_NEON=true
BACKUP_DIR=backups
BACKUP_LOCAL_RETENTION_DAYS=7
BACKUP_DRY_RUN=false
ALLOW_NON_NEON_BACKUP_TARGET=false

# =========================
# SMOKE TESTS
# =========================
# Solo lo usan scripts/smoke-deep.sh. No es variable del runtime principal.
SMOKE_TEST_EMAIL=pabliarca@gmail.com
