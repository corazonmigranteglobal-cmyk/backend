NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
APP_NAME=Corazon Migrante Backend
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
LOG_LEVEL=info
LOG_FILE_PATH=storage/logs/app.log

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=corazon_migrante
DATABASE_USER=corazon
DATABASE_PASSWORD=corazon
DATABASE_SSL=false
DATABASE_LOGGING=false

# En Coolify se recomienda REDIS_URL del Redis dedicado.
# Ejemplo: redis://default:password@redis-host-interno:6379/0
REDIS_ENABLED=true
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS=false

JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=30

BCRYPT_ROUNDS=10

# =========================
# RATE LIMITING (throttler)
# =========================
# TTL de la ventana de throttling en milisegundos (default: 60 000 ms = 1 minuto).
THROTTLER_TTL_MS=60000
# Máximo de peticiones por IP por ventana (default: 120).
THROTTLER_LIMIT=120

# Archivos
# CLOUDINARY = fotos publicas con subida directa desde el frontend y registro de URL en backend.
# LOCAL/GCS quedan solo como compatibilidad legacy.
STORAGE_PROVIDER=CLOUDINARY
UPLOAD_DIR=storage/uploads
MAX_UPLOAD_MB=8
PUBLIC_BASE_URL=http://localhost:3000
FILE_SIGNED_URL_EXPIRES_SECONDS=900

# Cloudinary. Requerido si STORAGE_PROVIDER=CLOUDINARY.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=corazon-migrante
CLOUDINARY_UPLOAD_PREFIX_USER_MEDIA=users
CLOUDINARY_UPLOAD_PREFIX_PUBLIC_ASSETS=public

# Google Cloud Storage legacy. Requerido solo si STORAGE_PROVIDER=GCS.
# En producción se recomienda usar Workload Identity / Service Account del runtime.
# En local puedes usar GOOGLE_APPLICATION_CREDENTIALS=/ruta/service-account.json
GCS_BUCKET=
GCP_PROJECT_ID=
GCS_PUBLIC_BASE_URL=
GOOGLE_APPLICATION_CREDENTIALS=

# Email
# DEV_NULL = simula envío. SENDGRID = envío real con SendGrid.
EMAIL_PROVIDER=DEV_NULL
EMAIL_FROM_EMAIL=
EMAIL_FROM_NAME=Corazón Migrante
SENDGRID_API_KEY=

# Backup diario (cron 3am) hacia uno o varios destinos.
# Requiere pg_dump y pg_restore instalados en el runtime/job.
# SOURCE_DATABASE_URL es opcional; si está vacío, se construye desde DATABASE_HOST/USER/PASSWORD/NAME.
SOURCE_DATABASE_URL=
NEON_BACKUP_DATABASE_URL=
VPS_BACKUP_DATABASE_URL=
BACKUP_CONFIRM_REMOTE_NEON=false
BACKUP_CONFIRM_REMOTE_VPS=false
BACKUP_RESTORE_TO_NEON=true
BACKUP_RESTORE_TO_VPS=true
BACKUP_DIR=backups
BACKUP_LOCAL_RETENTION_DAYS=7
BACKUP_DRY_RUN=false
ALLOW_NON_NEON_BACKUP_TARGET=false

# =========================
# SWAGGER (API docs en /docs)
# =========================
# true  → activo en cualquier entorno.
# false → desactivado incluso en development.
# omitido → activo solo si NODE_ENV != production.
SWAGGER_ENABLED=false

# =========================
# BASE DE DATOS — BOOTSTRAP
# =========================
# Controla qué tareas se ejecutan automáticamente al arrancar el servidor.
# En producción es seguro dejar los valores por defecto (migraciones + boot seeds activos).
DATABASE_MIGRATE_ON_STARTUP=true
DATABASE_SEED_BOOT_ON_STARTUP=true
# Mock data: activo por defecto en dev, desactivado en producción.
DATABASE_SEED_MOCKUP_ON_STARTUP=false
DATABASE_SEED_RERUN=false

# =========================
# OUTBOX / WORKER
# =========================
OUTBOX_WORKER_ENABLED=true
OUTBOX_BATCH_SIZE=50
OUTBOX_POLL_INTERVAL_MS=2000
OUTBOX_RETRY_BASE_DELAY_MS=30000

# =========================
# CONTENIDO PREMIUM (suscripción)
# =========================
# FileId del QR de pago y del PDF de instrucciones (se cargan desde el módulo Files).
NEWS_SUBSCRIPTION_QR_FILE_ID=
NEWS_SUBSCRIPTION_INSTRUCTIONS_FILE_ID=
NEWS_SUBSCRIPTION_PAYMENT_TITLE=Suscripción Corazón Migrante
NEWS_SUBSCRIPTION_AMOUNT_BOB=0
NEWS_SUBSCRIPTION_CURRENCY=BOB

# =========================
# DEPLOY — METADATA DE VERSIÓN
# =========================
# Se inyectan durante el build (p.ej. en GitHub Actions / Dockerfile).
# Expuestos en GET /health y GET /health/version.
# GIT_COMMIT=$(git rev-parse --short HEAD)
# BUILD_AT=$(date -u +%Y-%m-%dT%H:%M:%SZ)
GIT_COMMIT=
BUILD_AT=

# =========================
# PROXY / INGRESS
# =========================
# Número de saltos de proxy confiables (Render, Railway, Coolify usan 1 por defecto).
TRUST_PROXY_HOPS=1

# =========================
# SMOKE TESTS
# =========================
# Solo lo usan scripts/smoke-deep.sh. No es variable del runtime principal.
SMOKE_TEST_EMAIL=pabliarca@gmail.com

# =========================
# OBSERVABILIDAD (OpenTelemetry -> OTLP -> Jaeger)
# =========================
# Interruptor maestro. Con false el backend arranca exactamente igual que antes
# de introducir la telemetría: cero instrumentación, cero sockets abiertos.
OTEL_ENABLED=false

# Identidad del servicio. El worker de outbox sobrescribe el nombre por su cuenta
# (corazon-migrante-worker-outbox); no hace falta declararlo aquí.
OTEL_SERVICE_NAME=corazon-migrante-api
OTEL_SERVICE_NAMESPACE=corazon-migrante
# Si se omite, se usa la "version" de package.json.
OTEL_SERVICE_VERSION=
# Si se omite, se usa NODE_ENV.
OTEL_DEPLOYMENT_ENVIRONMENT=development

# Exportación. Fuera de Docker: localhost. Dentro de Docker: http://jaeger:4318/v1/traces
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
OTEL_EXPORT_TIMEOUT_MS=10000

# Muestreo. En desarrollo 1.0 (todo); en producción bajar a 0.05-0.20.
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0

OTEL_PROPAGATORS=tracecontext,baggage
# Diagnóstico interno del SDK: subir a DEBUG sólo para depurar la exportación.
OTEL_DIAG_LOG_LEVEL=ERROR
# Rutas sin traza. Si se deja vacío se usan las de telemetry.constants.ts.
OTEL_EXCLUDED_URLS=
OTEL_SHUTDOWN_TIMEOUT_MS=5000
