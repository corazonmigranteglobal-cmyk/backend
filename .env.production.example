NODE_ENV=production
PORT=3000
API_PREFIX=api/v1
APP_NAME=Corazon Migrante Backend
CORS_ORIGINS=https://corazonmigrante.com,https://admin.corazonmigrante.com

DATABASE_HOST=TU_HOST_POSTGRES
DATABASE_PORT=5432
DATABASE_NAME=corazon_migrante
DATABASE_USER=TU_USUARIO_DB
DATABASE_PASSWORD=TU_PASSWORD_DB
DATABASE_SSL=true
DATABASE_LOGGING=false

# Preferido en Coolify: usa la Internal Redis URL del recurso Redis dedicado.
REDIS_ENABLED=true
REDIS_URL=redis://default:TU_PASSWORD_REDIS@TU_HOST_REDIS:6379/0
# Alternativa si no usas REDIS_URL:
REDIS_HOST=TU_HOST_REDIS
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=TU_PASSWORD_REDIS
REDIS_DB=0
REDIS_TLS=false

JWT_ACCESS_SECRET=REEMPLAZAR_CON_OPENSSL_RAND_BASE64_48
JWT_REFRESH_SECRET=REEMPLAZAR_CON_OTRO_OPENSSL_RAND_BASE64_48
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=30
BCRYPT_ROUNDS=12

PUBLIC_BASE_URL=https://api.corazonmigrante.com
MAX_UPLOAD_MB=8
FILE_SIGNED_URL_EXPIRES_SECONDS=900

# Cloudinary real: fotos publicas con subida directa desde el frontend.
STORAGE_PROVIDER=CLOUDINARY
CLOUDINARY_CLOUD_NAME=tu-cloud-name
CLOUDINARY_API_KEY=tu-api-key
CLOUDINARY_API_SECRET=tu-api-secret
CLOUDINARY_FOLDER=corazon-migrante
CLOUDINARY_UPLOAD_PREFIX_USER_MEDIA=users
CLOUDINARY_UPLOAD_PREFIX_PUBLIC_ASSETS=public

# Google Cloud Storage legacy. Solo si necesitas leer/subir con STORAGE_PROVIDER=GCS.
GCS_BUCKET=
GCP_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=
GCS_PUBLIC_BASE_URL=

# SendGrid real
EMAIL_PROVIDER=SENDGRID
EMAIL_FROM_EMAIL=no-reply@corazonmigrante.com
EMAIL_FROM_NAME=Corazón Migrante
SENDGRID_API_KEY=SG.REEMPLAZAR

# Backup hacia una base remota de Neon.
# En producción se recomienda ejecutarlo desde GitHub Actions, cron externo o job separado.
SOURCE_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/corazon_migrante?sslmode=require
NEON_BACKUP_DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.neon.tech/corazon_migrante_backup?sslmode=require
VPS_BACKUP_DATABASE_URL=postgres://USER:PASSWORD@VPS_HOST:5432/backup_db
BACKUP_CONFIRM_REMOTE_NEON=true
BACKUP_CONFIRM_REMOTE_VPS=true
BACKUP_RESTORE_TO_NEON=true
BACKUP_RESTORE_TO_VPS=true
BACKUP_DIR=backups
BACKUP_LOCAL_RETENTION_DAYS=7
BACKUP_DRY_RUN=false
ALLOW_NON_NEON_BACKUP_TARGET=false
