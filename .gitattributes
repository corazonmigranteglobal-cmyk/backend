# Normalize line endings for all text files on commit
* text=auto eol=lf

# Force LF for files that must stay LF on all platforms
*.ts   text eol=lf
*.js   text eol=lf
*.json text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.md   text eol=lf
*.env* text eol=lf

# Binary files — never rewrite
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
