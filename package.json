{
  "name": "corazon-migrante-backend-reengineered",
  "version": "1.0.0",
  "description": "Backend NestJS reingenierizado para Corazón Migrante: API /api/v1 con Auth, RBAC, citas, catálogo, archivos, CMS, contabilidad, mensajería, auditoría y analytics.",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": ">=20 <27"
  },
  "scripts": {
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "build": "nest build && tsc-alias -p tsconfig.build.json",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "lint:fix": "eslint \"{src,test}/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"docs/**/*.md\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "typecheck": "tsc --noEmit",
    "check:secrets": "node scripts/check-no-secrets.js",
    "check:repository": "node scripts/check-repository-hygiene.js",
    "verify:ci": "yarn check:repository && yarn check:secrets && yarn check:validation-strict && yarn lint && yarn typecheck && yarn test --runInBand && yarn build",
    "audit:dependencies": "node scripts/audit-production-dependencies.js",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "db:seed": "node scripts/deploy-db.mjs --force --seeds-boot --seeds-mockup",
    "db:seed:boot": "node scripts/deploy-db.mjs --force --seeds-boot",
    "db:seed:mockup": "node scripts/deploy-db.mjs --force --seeds-mockup",
    "db:reset": "sequelize-cli db:migrate:undo:all && sequelize-cli db:migrate && node scripts/deploy-db.mjs --force --seeds-boot --seeds-mockup",
    "worker:outbox": "node dist/workers/outbox.worker.js",
    "smoke": "node scripts/smoke-deep.mjs",
    "db:backup:neon": "node scripts/backup-to-neon.js",
    "smoke:deep:win": "powershell -ExecutionPolicy Bypass -File scripts/smoke-deep.ps1",
    "smoke:deep:win:full": "powershell -ExecutionPolicy Bypass -File scripts/smoke-deep.ps1 -AllowMutations",
    "smoke:deep:win:external": "powershell -ExecutionPolicy Bypass -File scripts/smoke-deep.ps1 -AllowMutations -ProcessOutbox",
    "smoke:deep": "node scripts/smoke-deep.mjs",
    "smoke:deep:mutations": "node scripts/smoke-deep.mjs --mutations",
    "smoke:deep:external": "node scripts/smoke-deep.mjs --mutations --external",
    "smoke:bash": "bash scripts/smoke.sh",
    "smoke:deep:bash": "bash scripts/smoke-deep.sh",
    "smoke:deep:bash:mutations": "bash scripts/smoke-deep.sh --mutations",
    "smoke:deep:bash:external": "bash scripts/smoke-deep.sh --mutations --external",
    "smoke:publications": "node scripts/smoke-content-advertising.mjs --publications",
    "smoke:advertising": "node scripts/smoke-content-advertising.mjs --advertising",
    "smoke:homepage": "node scripts/smoke-content-advertising.mjs --homepage",
    "smoke:newspaper-internal": "node scripts/smoke-content-advertising.mjs --all",
    "check:validation-strict": "node scripts/check-validation-strict.mjs",
    "db:deploy": "node scripts/deploy-db.mjs",
    "db:deploy:with-seeds": "node scripts/deploy-db.mjs --seeders",
    "db:deploy:rerun-seeds": "node scripts/deploy-db.mjs --rerun-seeders",
    "jaeger:up": "docker compose -f docker-compose.jaeger.yml up -d",
    "jaeger:down": "docker compose -f docker-compose.jaeger.yml down",
    "jaeger:logs": "docker compose -f docker-compose.jaeger.yml logs -f",
    "verify:jaeger": "bash scripts/verify-jaeger.sh",
    "smoke:plan-action": "node scripts/smoke-plan-action.mjs",
    "smoke:plan-action:mutations": "node scripts/smoke-plan-action.mjs --mutations",
    "docs:openapi:generate": "ts-node -r tsconfig-paths/register --project tsconfig.json scripts/generate-openapi.ts",
    "docs:openapi:generate:env": "ts-node -r tsconfig-paths/register --project tsconfig.json scripts/generate-openapi.ts --use-env-database",
    "docs:openapi:lint": "redocly lint openapi/openapi.yaml",
    "docs:openapi:bundle": "redocly bundle openapi/openapi.yaml -o dist/openapi.yaml",
    "docs:openapi:coverage": "node scripts/check-openapi-coverage.mjs",
    "docs:links": "node scripts/check-doc-links.mjs",
    "docs:serve": "python -m mkdocs serve",
    "docs:build": "python -m mkdocs build --strict",
    "docs:validate": "yarn docs:openapi:lint && yarn docs:openapi:coverage && yarn docs:asyncapi:lint && yarn docs:links",
    "docs:modules": "node scripts/generate-module-docs.mjs",
    "docs:entities": "node scripts/generate-entity-catalog.mjs",
    "docs:generate": "yarn docs:openapi:generate && yarn docs:modules && yarn docs:entities",
    "docs:asyncapi:lint": "node scripts/validate-asyncapi.mjs",
    "db:retention:dry-run": "node scripts/purge-retention.mjs",
    "db:retention:apply": "node scripts/purge-retention.mjs --apply",
    "db:verify-restore": "node scripts/verify-restore.mjs",
    "files:check": "node scripts/backup-file-storage.mjs --check",
    "files:replicate": "node scripts/backup-file-storage.mjs --replicate"
  },
  "dependencies": {
    "@google-cloud/storage": "^7.21.0",
    "@nestjs/common": "11.1.28",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "11.1.28",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "11.1.28",
    "@nestjs/sequelize": "^11.0.1",
    "@nestjs/swagger": "^11.4.4",
    "@nestjs/throttler": "^6.5.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/core": "^2.10.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/instrumentation": "^0.221.0",
    "@opentelemetry/instrumentation-express": "^0.69.0",
    "@opentelemetry/instrumentation-http": "^0.221.0",
    "@opentelemetry/instrumentation-ioredis": "^0.69.0",
    "@opentelemetry/instrumentation-nestjs-core": "^0.67.0",
    "@opentelemetry/instrumentation-pg": "^0.73.0",
    "@opentelemetry/instrumentation-pino": "^0.67.0",
    "@opentelemetry/instrumentation-undici": "^0.20.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@opentelemetry/sdk-trace-base": "^2.10.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@scalar/nestjs-api-reference": "^1.2.12",
    "@sendgrid/mail": "^8.1.4",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^17.4.2",
    "helmet": "^7.2.0",
    "ioredis": "^5.4.1",
    "joi": "^17.13.3",
    "luxon": "^3.5.0",
    "multer": "2.2.0",
    "pg": "^8.13.1",
    "pg-hstore": "^2.3.4",
    "pino": "^10.3.1",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sequelize": "^6.37.5",
    "sequelize-typescript": "^2.1.6"
  },
  "devDependencies": {
    "@asyncapi/parser": "^3.6.1",
    "@nestjs/cli": "^11.0.23",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.27",
    "@opentelemetry/context-async-hooks": "^2.10.0",
    "@redocly/cli": "^2.43.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/luxon": "^3.4.2",
    "@types/multer": "2.2.0",
    "@types/node": "^22.10.2",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.18.2",
    "@typescript-eslint/parser": "^8.18.2",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "jest": "^29.7.0",
    "jest-util": "29.7.0",
    "prettier": "^3.4.2",
    "sequelize-cli": "^6.6.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.10",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.2",
    "yaml": "^2.9.0"
  },
  "overrides": {
    "multer": "$multer"
  },
  "resolutions": {
    "multer": "2.2.0",
    "@google-cloud/storage/fast-xml-parser": "^5.10.1",
    "sequelize-typescript/**/brace-expansion": "^1.1.18"
  }
}
