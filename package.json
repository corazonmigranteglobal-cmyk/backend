{
  "name": "corazon-migrante-backend-reengineered",
  "version": "1.0.0",
  "description": "Backend NestJS reingenierizado para Corazón Migrante: API /api/v1 con Auth, RBAC, citas, catálogo, archivos, CMS, contabilidad, mensajería, auditoría y analytics.",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20 <27"
  },
  "scripts": {
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "build": "nest build && tsc-alias -p tsconfig.build.json",
    "lint": "eslint \"{src,test}/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"docs/**/*.md\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "db:seed": "sequelize-cli db:seed:all",
    "db:reset": "sequelize-cli db:migrate:undo:all && sequelize-cli db:migrate && sequelize-cli db:seed:all",
    "worker:outbox": "node dist/workers/outbox.worker.js",
    "smoke": "node scripts/smoke-deep.mjs",
    "db:backup:neon": "node scripts/backup-to-neon.js",
    "smoke:deep:win": "powershell -ExecutionPolicy Bypass -File scripts/smoke-deep.ps1",
    "smoke:deep:win:full": "powershell -ExecutionPolicy Bypass -File scripts/smoke-deep.ps1 -AllowMutations",
    "smoke:deep:win:external": "powershell -ExecutionPolicy Bypass -File scripts/smoke-deep.ps1 -AllowMutations -ProcessOutbox",
    "smoke:deep": "node scripts/smoke-deep.mjs",
    "smoke:deep:mutations": "node scripts/smoke-deep.mjs --mutations",
    "smoke:deep:external": "node scripts/smoke-deep.mjs --mutations --external",
    "smoke:bash": "bash scripts/smoke.sh",
    "smoke:deep:bash": "bash scripts/smoke-deep.sh",
    "smoke:deep:bash:mutations": "bash scripts/smoke-deep.sh --mutations",
    "smoke:deep:bash:external": "bash scripts/smoke-deep.sh --mutations --external"
  },
  "dependencies": {
    "@google-cloud/storage": "^7.21.0",
    "@nestjs/common": "^11.1.27",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.27",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.1.27",
    "@nestjs/sequelize": "^11.0.1",
    "@nestjs/swagger": "^11.4.4",
    "@sendgrid/mail": "^8.1.4",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.4.7",
    "helmet": "^7.2.0",
    "ioredis": "^5.4.1",
    "joi": "^17.13.3",
    "luxon": "^3.5.0",
    "multer": "2.2.0",
    "pg": "^8.13.1",
    "pg-hstore": "^2.3.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sequelize": "^6.37.5",
    "sequelize-typescript": "^2.1.6"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.23",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.27",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/luxon": "^3.4.2",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.2",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.18.2",
    "@typescript-eslint/parser": "^8.18.2",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "jest": "^29.7.0",
    "jest-util": "29.7.0",
    "prettier": "^3.4.2",
    "sequelize-cli": "^6.6.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.10",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.2"
  },
  "overrides": {
    "multer": "$multer"
  }
}
