backups/
*.dump
*.backup

# Project archives are release artifacts, not source files.
*.zip

storage/uploads/*
storage/tmp/*
storage/logs/*
!storage/uploads/.gitkeep
!storage/logs/.gitkeep

npm-debug.log*
yarn-error.log*
